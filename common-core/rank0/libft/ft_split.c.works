#include "libft.h"
/* allocate ptr, cpy and store*/
char	*ft_allocptr(char *src, int len)
{
	char	*s;

	s = (char *) malloc(sizeof(char) * (len + 1));
	if (!s)
		return (NULL);
	ft_memcpy(s, src, len); 
	s[len] = '\0';
	return (s);
}

char	**ft_allocarray(int	cnt)
{
	char	**arr;
	char	*ptr;
	
	arr = (void *) malloc(sizeof(ptr) * (cnt + 1)); // accounts for 1 null ptr
	if (!arr)
		return (NULL);
	return (arr);	
}

char	**ft_split(char const *s, char c)
{
	char	**arr;
	char	*str; 
	char	*ptr; 
	char	*tmp;
	int	cnt; //cnt = counts the number of strings in s
	int	j;
	int	len;
	
	//trim the string in order to have only valid strings
	ptr = ft_strtrim(s, &c);
	cnt = 0; 
	if (ptr && *ptr != '\0')
	{
		str = ptr;
		while ((ft_strlen(str) > 0) && (ft_strnpchr(str, c) != NULL))
		{
			len = (int) (ft_strnpchr(str, c) - str);
			if (len >= 1)
				cnt++;
			str = ft_strnpchr(str, c) + 1; //points after c
		}
		//add one string if c is not last char
		cnt++;
	}
	arr = ft_allocarray(cnt);
	if (!arr)
		return (NULL);
	//now split and store in arr
	j = 0;
	str = ptr;
	while (j < cnt)
	{
		//skip all c
		while ((*str != '\0') && (*str == c))
			str++;
		if (j < (cnt - 1))
			len = (int)(ft_strnpchr(str, c) - str);
		else
			len = ft_strlen(str);
		tmp = ft_allocptr(str, len);
		arr[j] = tmp;			
		str = ft_strnpchr(str, c) + 1;	
		j++;
	}
	if (ptr) //if (ptr && *ptr != '\0')	
		free(ptr); //do we have to check if ptr !=0
	//last string
	arr[cnt] = NULL;
	return (arr);
}
